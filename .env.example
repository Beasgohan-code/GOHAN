# =============================================================================
#  GOHAN — configuration
#  Copy to .env and fill in.  Anything left blank falls back to a safe default.
#  Run `python -m gohan --check` afterwards to validate without starting the bot.
# =============================================================================

# --- Telegram Bot API (required) --------------------------------------------
# Get it from @BotFather -> /newbot
BOT_TOKEN=

# --- Kurigram / MTProto (optional, but unlocks the good stuff) --------------
# Get these from https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# auto  = use a user session if one exists / can be created, else a bot session
# user  = force user session (full history, channels you are not in)
# bot   = force bot session (bot_token, still no 20 MB upload cap)
# off   = do not start MTProto at all
MTPROTO_MODE=auto
SESSION_DIR=data/sessions
USER_SESSION_NAME=gohan_user
BOT_SESSION_NAME=gohan_bot
# Only needed for non-interactive first login (docker, CI). Prefer logging in
# interactively once: `python -m gohan --login`
PHONE=

# --- Access control ---------------------------------------------------------
# Comma-separated numeric user ids. When set, owner-only commands are restricted
# to these users. Leave empty to allow only the bot's own /start user flow.
OWNER_USER_IDS=

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=data/gohan.sqlite3

# --- LLM (powers /ask streaming + rich answers) -----------------------------
# off               = no network calls, deterministic local demo generator
# openai_compatible = any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=off
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Rich messages ----------------------------------------------------------
# Deliver rich messages by default; users can toggle with /rich
RICH_DEFAULT=true
# auto = HTML string (simplest) | html = force HTML | blocks = typed block entities
RICH_MODE=auto
# Use <tg-emoji> custom emoji (from @TgEmojis). Needs Telegram Premium on the
# bot owner's account - set to false to fall back to plain emoji everywhere.
CUSTOM_EMOJI=true

# --- Behaviour --------------------------------------------------------------
# Minimum seconds between two messages to the same user (anti-flood)
THROTTLE_DELAY=0.6
# Minimum seconds between two draft (streaming) edits
DRAFT_INTERVAL=0.7
# Hard ceiling for MTProto downloads, in MB
MAX_DOWNLOAD_MB=2000

# --- Keep-alive web server (health checks + self-ping on free hosts) --------
KEEP_ALIVE=true
PORT=8080
# Leave empty to auto-detect from RENDER_EXTERNAL_URL / KOYEB_PUBLIC_DOMAIN / …
KEEP_ALIVE_URL=
# Seconds between self-pings (300 s is the usual free-tier sleep threshold)
KEEP_ALIVE_INTERVAL=240

# --- Web control panel (served by the keep-alive port) ----------------------
# The dashboard lives at http://<host>:PORT/  (status page moved to /status)
WEB_DASHBOARD=true
# off      = anyone who can reach the port gets in (private networks, demo)
# token    = shared secret in WEB_TOKEN (auto-generated into data/.web_token)
# telegram = Telegram Mini App initData, verified with BOT_TOKEN
WEB_AUTH=off
WEB_TOKEN=
# extra user ids allowed in when WEB_AUTH=telegram (defaults to OWNER_USER_IDS)
WEB_ALLOWED_IDS=

# --- Watchdog (disk, temp files, abandoned flows, hung connections) ---------
WATCHDOG=true
WATCHDOG_INTERVAL=600
CLEANUP_AFTER_HOURS=6
MIN_FREE_DISK_GB=2
STATE_TIMEOUT_MIN=15
# Restart the process when Telegram is unreachable for 3 checks in a row
AUTO_RESTART_ON_HANG=true

# --- Log channel (Videl1-style reports) -------------------------------------
# A private channel id like -1001234567890. Leave 0 to log to owner DMs only.
LOG_CHANNEL_ID=0
# Event tags that are also sent as a DM to every OWNER_USER_IDS
OWNER_DM_EVENTS=Error,LowDisk,AutoRestart,BotStopped,WatchdogRestart
LOG_START_EVENTS=true
START_LOG_COOLDOWN_MIN=30
DAILY_REPORT=true
DAILY_REPORT_HOUR=0
# Asia/Kolkata, UTC, Europe/Berlin, …
LOG_TIMEZONE=Asia/Kolkata

# --- Optional features ------------------------------------------------------
# /music and /download need `pip install "gohan[media]"` (yt-dlp) + ffmpeg.
# Without them the commands still work, but return search links instead of files.
# /anime and /trending use the free AniList API - no key, nothing to configure.
# The AI assistant runs without a key too: LLM_PROVIDER=off uses a local demo
# generator, so the bot always starts.

# --- Runtime ----------------------------------------------------------------
# DROP_PENDING_UPDATES=false replays messages that arrived while offline
DROP_PENDING_UPDATES=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
