# --- Required -----------------------------------------------------------
# Bot token from @BotFather
BOT_TOKEN=123456789:PUT-YOUR-TOKEN-HERE

# --- Access control (comma separated Telegram user ids).
# Leave empty to allow everyone. Recommended for a personal publisher.
OWNER_IDS=123456789

# --- Optional: Kurigram (MTProto) engine --------------------------------
# Get api_id/api_hash at https://my.telegram.org — enables:
#   /latest (read channel history), richer /chinfo, publish fallback.
# Without them the bot still runs 100% on the Bot API (aiogram).
API_ID=
API_HASH=

# Optional user-account session string (Kurigram). If empty while
# API_ID/API_HASH are set, the MTProto engine logs in as the BOT itself.
SESSION_STRING=

# --- Misc ----------------------------------------------------------------
# Timezone used for human-readable schedule confirmations
TZ=Asia/Kolkata
# SQLite database file
DATABASE=gohan.db
# Default message effect id for the ✨ toggle (find one via clients / @vote)
EFFECT_ID=
